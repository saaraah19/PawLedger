# Easiest: run `npm run setup` from the project folder and it writes server/.env for you.
# Or copy this file to server/.env and fill it in. Never commit or share the real file.

PORT=4000

# Local MongoDB: mongodb://127.0.0.1:27017/pawledger
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pawledger?retryWrites=true&w=majority
MONGODB_URI=

# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Open while you create your own account, then set to false (or run `npm run close-registration`).
ALLOW_REGISTRATION=true

# Development with `npm run dev`: the client runs separately on this address (CORS).
CLIENT_URL=http://localhost:5173
COOKIE_SAMESITE=lax

# Single-service mode (used on Render): the server also serves the built client, so there is one address.
# Run `npm run build` first. Leave false for `npm run dev`.
SERVE_CLIENT=false
